<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="WongiEngineWebui" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- In dev, Volt injects app.js's CSS imports itself (with HMR) --%>
    <link
      :if={!dev_server?(@conn)}
      phx-track-static
      rel="stylesheet"
      href={Volt.static_path(@conn, "/assets/css/app.css")}
    />
    <script
      defer
      phx-track-static
      type="module"
      src={Volt.static_path(@conn, "/assets/js/app.js")}
    >
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
