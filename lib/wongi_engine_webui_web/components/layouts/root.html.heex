<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="live-socket-path" content={@live_socket_path} />
    <.live_title default="Wongi Engine" suffix=" · Wongi Engine">
      {assigns[:page_title]}
    </.live_title>
    <link :if={@asset_css} rel="stylesheet" href={@asset_css} />
    <script defer type="module" src={@asset_js}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
